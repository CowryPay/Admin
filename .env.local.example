# Same backend as the consumer app (cowrypay-frontend).
NEXT_PUBLIC_API_URL=https://cowrypay-backend-production.up.railway.app

# NOTE: the admin key is deliberately NOT an env var here. It is typed into the
# login screen, verified against GET /admin/overview, and kept in sessionStorage
# for that tab only. Putting it in a NEXT_PUBLIC_* var would ship the shared
# secret to every visitor in the client bundle.
